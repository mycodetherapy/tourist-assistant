                      "type": "null"
                    }
                  ],
                  "title": "Response Get Preferences Api Trips  Trip Id  Preferences Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{trip_id}/runs": {
      "post": {
        "tags": [
