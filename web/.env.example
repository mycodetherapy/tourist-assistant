# Ключ JavaScript API Яндекс.Карт (выбор базовой точки при новой прогулке).
# Локально: здесь или в корневом .env (Vite envDir → корень репозитория).
# Docker (docker compose --profile docker-web): web/.env и/или VITE_YANDEX_MAPS_API_KEY в корневом .env.
# Получить: https://developer.tech.yandex.ru/
# VITE_YANDEX_MAPS_API_KEY=

# Яндекс Метрика — аналитика лендинга (ID счётчика, только цифры).
# Получить: https://metrika.yandex.ru/ → Добавить счётчик → скопировать номер.
# VITE_YANDEX_METRIKA_ID=

# Яндекс SmartCaptcha — invisible-проверка на /try перед сборкой маршрута (guest).
# Получить ключи: https://cloud.yandex.ru/docs/smartcaptcha/
# VITE_YANDEX_SMARTCAPTCHA_CLIENT_KEY=

# SmartCaptcha test mode (invisible): VITE_YANDEX_SMARTCAPTCHA_TEST=true — всегда challenge
# VITE_YANDEX_SMARTCAPTCHA_TEST=true

# Прокси /api на бэкенд (см. web/vite.config.ts)
# VITE_API_PORT=8001   # api-node (по умолчанию)

# HTTPS для dev-сервера (геолокация с телефона по LAN; браузер попросит доверять сертификату).
# Включено по умолчанию, если в сети есть LAN IP. Отключить: VITE_DEV_HTTPS=false

# Карта маршрута: maplibre (prod Docker default) или iframe. См. docs/maps-osrm-maplibre.md
# MapLibre показывается только при наличии route_geometry; иначе iframe Яндекса.
VITE_MAP_PROVIDER=maplibre
