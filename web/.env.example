# Ключ JavaScript API Яндекс.Карт (выбор базовой точки на новой поездке).
# Можно задать здесь или в корневом .env (Vite envDir → корень репозитория).
# Получить: https://developer.tech.yandex.ru/
# VITE_YANDEX_MAPS_API_KEY=

# Прокси /api на бэкенд (см. web/vite.config.ts)
# VITE_API_PORT=8001   # api-node (по умолчанию)

# HTTPS для dev-сервера (геолокация с телефона по LAN; браузер попросит доверять сертификату).
# Включено по умолчанию, если в сети есть LAN IP. Отключить: VITE_DEV_HTTPS=false
