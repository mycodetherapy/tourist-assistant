# Node API + Python repair_program_cli (parity с trip_service.get_program_view)
FROM node:20-bookworm-slim AS node-build

WORKDIR /app/api-node
COPY api-node/package.json api-node/package-lock.json ./
RUN npm ci
COPY api-node/tsconfig.json api-node/vitest.config.ts ./
COPY api-node/src ./src
RUN npm run build && npm prune --omit=dev

FROM python:3.11-slim-bookworm

WORKDIR /app

# Node runtime без NodeSource (на bookworm setup_20.x часто падает с apt exit 100).
COPY --from=node:20-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:20-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY agents agents
COPY auth auth
COPY config config
COPY db db
COPY models models
COPY onboarding onboarding
COPY planning planning
COPY program program
COPY search search
COPY services services
COPY scripts/repair_program_cli.py scripts/repair_program_cli.py

COPY --from=node-build /app/api-node/dist /app/api-node/dist
COPY --from=node-build /app/api-node/node_modules /app/api-node/node_modules
COPY --from=node-build /app/api-node/package.json /app/api-node/package.json

ENV PYTHON_PATH=/usr/local/bin/python
ENV API_NODE_PORT=8001
WORKDIR /app/api-node
EXPOSE 8001

CMD ["node", "dist/index.js"]
