# Eval и скрипты: LLM_API_KEY в .env (для python -m eval).
# Веб-API (SaaS): BYOK в профиле пользователя.

LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_OPENROUTER_PROVIDERS=Azure

# PostgreSQL + Redis (обязательно для API и worker):
DATABASE_URL=postgresql+psycopg://tourist:tourist@localhost:5433/tourist
# Отдельная БД для unit-тестов (TRUNCATE). Обязательна для python -m unittest discover.
TEST_DATABASE_URL=postgresql+psycopg://tourist:tourist@localhost:5433/tourist_test
REDIS_URL=redis://localhost:6380/0
# Docker compose (сервисы postgres/redis в compose-сети):
# DATABASE_URL=postgresql+psycopg://tourist:tourist@postgres:5432/tourist
# REDIS_URL=redis://redis:6379/0
# RUN_QUOTA_FULL_PER_HOUR=5
# RUN_QUOTA_PARTIAL_PER_HOUR=10
# RUN_QUOTAS_ENABLED=false   # локально: отключить лимиты прогонов

# Node.js API (api-node/, Postgres only)
# API_NODE_PORT=8001
# PYTHON_PATH=python3   # для repair_program_cli (локально: .venv/bin/python)

# SaaS API (обязательно для api-node и worker)
JWT_SECRET=change-me-to-random-64-chars
JWT_ACCESS_TTL_MINUTES=60
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
# Google OAuth (опционально)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
# Прод-домен фронтенда через запятую
CORS_ORIGINS=
# URL фронтенда для Google OAuth redirect (api-node)
FRONTEND_URL=http://localhost:5173

# Яндекс.Карты: Geocoder на api-node; JS API — VITE_* (сборка web, см. web/.env)
# YANDEX_MAPS_API_KEY=
# VITE_YANDEX_MAPS_API_KEY=

# LangSmith (опционально): трейсы графа
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tourist-assistant
LANGSMITH_ENDPOINT=

# LangFuse (self-hosted, опционально): трейсы через LangChain callbacks
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST_DOCKER=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
