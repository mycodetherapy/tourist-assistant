# Минимум для запуска
#
# - Зарубежье (ProxyAPI): OPENAI_API_KEY + PROXY_BASE_URL_INTL
# - РФ (Yandex Cloud): YANDEX_API_KEY + PROXY_BASE_URL_RU (+ опционально YANDEX_FOLDER_ID)

# Зарубежные модели через ProxyAPI (https://proxyapi.ru)
OPENAI_API_KEY=sk-...
PROXY_BASE_URL_INTL=https://openai.api.proxyapi.ru/v1
LLM_MODEL_INTL=gpt-4o-mini

# Российские модели через Yandex Cloud (НЕ proxyapi.ru)
YANDEX_API_KEY=
# Опционально: если `LLM_MODEL_RU` не содержит `gpt://<folder_id>/...`
YANDEX_FOLDER_ID=
PROXY_BASE_URL_RU=https://llm.api.cloud.yandex.net/v1
LLM_MODEL_RU=gpt://<folder_id>/aliceai-llm/latest

# Роутинг модели по направлению:
# - auto: определяем по городу поездки
# - ru / intl: принудительно
LLM_REGION=auto

# Общий fallback endpoint (если RU/INTL не заданы) — оставьте как ProxyAPI.
PROXY_BASE_URL=https://openai.api.proxyapi.ru/v1

# Опционально: более точный веб-поиск (https://tavily.com)
# Без ключа используется DuckDuckGo
TAVILY_API_KEY=

# Фаза 2 (авиа API, пересадки): Travelpayouts / Aviasales Data API
# TRAVELPAYOUTS_API_KEY=

# SQLite: поездки, предпочтения, версии программы
DATABASE_PATH=data/trips.db

# LangSmith (опционально): трейсы графа
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tourist-assistant

# LangFuse (self-hosted, опционально): трейсы запусков агента
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
