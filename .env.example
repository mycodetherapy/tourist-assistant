# Eval и скрипты: LLM_API_KEY в .env (для python -m eval).
# Веб-API (SaaS): BYOK в профиле пользователя.

LLM_API_KEY=sk-...
LLM_BASE_URL=https://openai.api.proxyapi.ru/v1
LLM_MODEL=gemini/gemini-2.5-flash
# Только для Base URL с openrouter.ai:
# LLM_OPENROUTER_PROVIDERS=Azure

# PostgreSQL + Redis (обязательно для API и worker):
DATABASE_URL=postgresql+psycopg://tourist:tourist@localhost:5433/tourist
# Отдельная БД для unit-тестов (TRUNCATE). Обязательна для python -m unittest discover.
TEST_DATABASE_URL=postgresql+psycopg://tourist:tourist@localhost:5433/tourist_test
REDIS_URL=redis://localhost:6380/0
# Docker compose (сервисы postgres/redis в compose-сети):
# DATABASE_URL=postgresql+psycopg://tourist:tourist@postgres:5432/tourist
# REDIS_URL=redis://redis:6379/0
# RUN_QUOTA_FULL_PER_HOUR=5
# RUN_QUOTA_PARTIAL_PER_HOUR=10
# RUN_QUOTAS_ENABLED=false   # локально: отключить лимиты прогонов
# FREE_RUN_QUOTA_PER_DAY=30
# FREE_RUN_QUOTA_WINDOW_SEC=86400
# FREE_RUN_QUOTAS_ENABLED=true
# GUEST_SESSION_TTL_DAYS=7
# GUEST_GEOCODE_QUOTA_PER_HOUR=40
# GUEST_CLEANUP_INTERVAL_SEC=21600
# GUEST_CLEANUP_ORPHAN_GRACE_HOURS=24
# ESTIMATED_AI_RUN_COST_RUB=4

# Node.js API (api-node/, Postgres only)
# API_NODE_PORT=8001
# PYTHON_PATH=python3   # для repair_program_cli (локально: .venv/bin/python)

# SaaS API (обязательно для api-node и worker)
JWT_SECRET=change-me-to-random-64-chars
JWT_ACCESS_TTL_MINUTES=60
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
# Google OAuth (опционально). Один client — несколько redirect URI в Google Console:
#   https://progulyai.ru/api/auth/google/callback          (prod)
#   https://localhost:5173/api/auth/google/callback        (local HTTPS dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
# redirect_uri в OAuth = {origin фронта}/api/auth/google/callback (?frontend= из браузера)
# Прод-домен фронтенда через запятую
CORS_ORIGINS=
# URL фронтенда для Google OAuth redirect (api-node)
FRONTEND_URL=http://localhost:5173

# Яндекс.Карты: Geocoder на api-node; JS API — VITE_* (сборка web, см. web/.env)
# YANDEX_MAPS_API_KEY=
# VITE_YANDEX_MAPS_API_KEY=
# Пеший OSRM (worker заполняет route_geometry). План: docs/maps-osrm-maplibre.md
# Worker на хосте:
# OSRM_BASE_URL=http://127.0.0.1:5001
# Worker в docker compose (сервис osrm в той же сети):
# OSRM_BASE_URL=http://osrm:5000
# OSRM_DATASET=kazan
# OSRM_HOST_PORT=5001   # на macOS :5000 часто занят AirPlay
# Карта маршрута: maplibre (opt-in) или yandex iframe (дефолт / фолбек)
# VITE_MAP_PROVIDER=maplibre
# YANDEX_SMARTCAPTCHA_SERVER_KEY=   # api-node, ysc2_...
# VITE_YANDEX_SMARTCAPTCHA_CLIENT_KEY=  # web, ysc1_...
# Яндекс Метрика: ID счётчика для лендинга (сборка web, см. README «Аналитика»)
# VITE_YANDEX_METRIKA_ID=

# LangSmith (опционально): трейсы графа
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tourist-assistant
LANGSMITH_ENDPOINT=

# LangFuse (self-hosted, опционально): трейсы через LangChain callbacks
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST_DOCKER=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
