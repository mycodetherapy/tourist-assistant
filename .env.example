# Минимум для запуска: LLM_API_KEY + LLM_BASE_URL (OpenRouter)

LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# OpenRouter: белый список провайдеров. По умолчанию Azure (openai/gpt-4.1-mini без VPN).
# Альтернативы — см. README «Модели LLM» (Google, DeepSeek, Meta, Mistral, openai/gpt-4o-mini+VPN).
# LLM_OPENROUTER_PROVIDERS=Azure
# LLM_OPENROUTER_PROVIDERS=Google,Google AI Studio
# LLM_OPENROUTER_PROVIDERS=   # пусто — любой провайдер OpenRouter

# Опционально: более точный веб-поиск (https://tavily.com)
# Без ключа используется DuckDuckGo
TAVILY_API_KEY=

# Авиа API (цены, пересадки): https://www.travelpayouts.com/developers/api
# Без ключа — только deep links на агрегаторы
TRAVELPAYOUTS_API_KEY=


# POI для маршрутов: OpenStreetMap (Overpass) + Wikidata + веб-discovery (без Yandex Geocoder)
# POI_USE_WIKIDATA=true
# POI_USE_DISCOVERY=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=tourist-assistant/1.0 (contact: you@example.com)

# Яндекс.Карты: опционально, только для проверки legacy Geocoder (POI больше не используют)
# YANDEX_MAPS_API_KEY=

# SQLite: поездки, предпочтения, версии программы
DATABASE_PATH=data/trips.db

# LangSmith (опционально): трейсы графа
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tourist-assistant

# LangFuse (self-hosted, опционально): трейсы через LangChain callbacks
LANGFUSE_ENABLED=false
# Локальный запуск: python3 main.py
LANGFUSE_HOST=http://localhost:3000
# Docker: docker compose run --rm app (compose подставит этот URL)
LANGFUSE_HOST_DOCKER=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
