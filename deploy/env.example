# Шаблон .env для VPS (/opt/tourist-assistant/.env). Не коммитьте реальные секреты.

# Тег образов из GHCR (записывается deploy_prod.sh в .deploy-image-tag)
# IMAGE_TAG=<git-sha>
# Ручная проверка: bash prod_ps.sh  или  export IMAGE_TAG=latest

# GHCR (опционально, если префикс отличается от ghcr.io/mycodetherapy/tourist-assistant)
# GHCR_IMAGE_PREFIX=ghcr.io/mycodetherapy/tourist-assistant

POSTGRES_PASSWORD=change-me-strong-password

JWT_SECRET=change-me-to-random-64-chars
# Целое число минут (≥5); пустое/некорректное значение → 60
JWT_ACCESS_TTL_MINUTES=60
SETTINGS_ENCRYPTION_KEY=
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

FRONTEND_URL=https://progulyai.ru
CORS_ORIGINS=https://progulyai.ru,https://www.progulyai.ru
# В Google Console (тот же OAuth client, что и для dev) добавьте оба redirect URI:
#   https://progulyai.ru/api/auth/google/callback
#   https://localhost:5173/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://progulyai.ru/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

YANDEX_MAPS_API_KEY=

# OSRM (пешая geometry). На 4 ГБ VPS — ephemeral (графы на диске).
# Абсолютный путь ХОСТА к data/cities (bind mount из worker → osrm-ephemeral):
OSRM_MODE=ephemeral
OSRM_HOST_DATA_CITIES=/opt/tourist-assistant/data/cities
# Абсолютный путь хоста к data/ (docker -v из worker: osmium/osrm prepare)
TOURIST_HOST_DATA_DIR=/opt/tourist-assistant/data
OSRM_DOCKER_NETWORK=progulyai
OSRM_EPHEMERAL_URL=http://osrm-ephemeral:5000
# Один раз на VPS (create без pull → 404 No such image):
#   docker pull ghcr.io/project-osrm/osrm-backend:v5.27.1
# Не задавайте OSRM_DATASET на prod ephemeral — иначе worker skip чужих городов.
# Self-serve: FO subset в /opt/tourist-assistant/data/fo/ (см. docs/city-catalog-policy.md)
# RESEND_API_KEY=
# MAIL_FROM=Прогуляй <noreply@progulyai.ru>
# OSRM_PREPARE_QUOTA_PER_USER=3
# OSRM_PREPARE_MIN_FREE_GB=5
# Nightly (crontab на VPS, Europe/Moscow 02:15):
#   15 2 * * * cd /opt/tourist-assistant && IMAGE_TAG=$(cat .deploy-image-tag) \
#     docker compose --env-file .env -f docker-compose.prod.yml exec -T worker \
#     python scripts/osrm_nightly_refresh.py
# Локальный always-on (profile osrm): OSRM_MODE=http + OSRM_DOCKER_BASE_URL=http://osrm:5000

# Опционально: LangSmith / LangFuse
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tourist-assistant
